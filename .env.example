# Copy to .env at the repository root. Never commit .env.
DATABASE_URL=postgresql://paperlens:paperlens@localhost:55432/paperlens
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
NODE_ENV=development
# Required for actual analysis and chat. Server only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TPM_LIMIT=8000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=paperlens
S3_ACCESS_KEY=paperlens
S3_SECRET_KEY=paperlens-local-secret
MAX_FILE_MB=25
MAX_PAPERS=10
MAX_PAGES=150
MAX_CHUNKS=400
MAX_CONTEXT_CHARS=90000
MAX_OUTPUT_TOKENS=4000
MAX_AI_CALLS_PER_RUN=500
PAPER_CONCURRENCY=1
WORKER_CONCURRENCY=1
